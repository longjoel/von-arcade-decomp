#!/usr/bin/env python3
"""Summarize a sandbox_versus three-input weapon probe log."""

import argparse
import re
from pathlib import Path


ROW_RE = re.compile(
    r"weapon: f(?P<frame>\d+) (?P<tag>\S+) case=(?P<case>\S+) "
    r"resources=(?P<resources>[^ ]+) availability=(?P<available>[^ ]+) "
    r"timers=(?P<timers>[^ ]+)"
)


def parse(path):
    rows = []
    for line in path.read_text(errors="replace").splitlines():
        match = ROW_RE.search(line)
        if not match:
            continue
        rows.append(
            {
                "frame": int(match.group("frame")),
                "tag": match.group("tag"),
                "case": match.group("case"),
                "available": [int(value, 16) for value in match.group("available").split(",")],
                "timers": [int(value, 16) for value in match.group("timers").split(",")],
            }
        )
    return rows


def summarize(rows):
    if not rows:
        raise SystemExit("no weapon rows found")
    cases = sorted({row["case"] for row in rows})
    print(f"rows: {len(rows)} frames {rows[0]['frame']}..{rows[-1]['frame']}")
    print(f"cases: {', '.join(cases)}")
    for slot in range(3):
        starts = []
        ends = []
        transitions = []
        previous_timer = rows[0]["timers"][slot]
        previous_available = rows[0]["available"][slot]
        active_start = None
        for row in rows[1:]:
            timer = row["timers"][slot]
            available = row["available"][slot]
            if previous_timer == 0 and timer > 0:
                starts.append((row["frame"], timer, row["case"]))
                active_start = row["frame"]
            elif previous_timer > 0 and timer == 0 and active_start is not None:
                ends.append((active_start, row["frame"], row["frame"] - active_start))
                active_start = None
            if available != previous_available:
                transitions.append((row["frame"], previous_available, available, timer))
            previous_timer = timer
            previous_available = available
        print(f"slot {slot + 1}: starts={starts}")
        print(f"slot {slot + 1}: durations={ends}")
        print(f"slot {slot + 1}: availability={transitions}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("log", type=Path)
    summarize(parse(parser.parse_args().log))


if __name__ == "__main__":
    main()
