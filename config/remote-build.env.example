# Copy this file to remote-build.local.env and adjust only if needed.
VON_REMOTE_HOST=zathras
# Directory on the remote host for the mame-von fork clone, relative to $HOME.
VON_REMOTE_MAME_DIR=mame-von
VON_MAME_BUILD_IMAGE=von-mame-build:ubuntu26.04
VON_REMOTE_JOBS=16
# Directory on the remote host for the rsynced test tree (relative to $HOME).
VON_REMOTE_TEST_DIR=von-arcade-decomp
