# User-supplied ROMs and generated emulator output are never repository data.
/third_party/*
!/third_party/patches/
!/third_party/patches/**
/von/artifacts/*
!/von/artifacts/.gitkeep
/von/captures/
/von/build/
/dist/
# Root-level probe and emulator logs are generated artifacts.
/*.log
/*.trace
/config/remote-build.local.env
/bin/von
/cfg/
/nvram/
/snap/
__pycache__/
*.py[cod]
