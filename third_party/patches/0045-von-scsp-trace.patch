+static FILE *von_scsp_trace_file()
+{
+	static FILE *fp = nullptr;
+	static bool tried = false;
+	if (!tried)
+	{
+		tried = true;
+		const char *path = getenv("VON_SCSP_TRACE");
+		if (path)
+			fp = fopen(path, "w");
+	}
+	return fp;
+}
