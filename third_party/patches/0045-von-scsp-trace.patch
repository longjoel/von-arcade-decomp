 void scsp_device::StartSlot(SCSP_SLOT *slot)
 {
 	slot->active = 1;
@@ -593,11 +607,36 @@ void scsp_device::StartSlot(SCSP_SLOT *slot)
 
 	Compute_LFO(slot);
 
+	if (FILE *fp = von_scsp_trace_file())
+		fprintf(fp, "K %.6f %d %x %x %x %d %d\n", machine().time().as_double(),
+			(int)(slot - m_Slots), SA(slot), LSA(slot), LEA(slot), OCT(slot), FNS(slot));
