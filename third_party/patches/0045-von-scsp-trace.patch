+			if (FILE *rf = fopen(dump_path, "wb"))
+			{
+				for (int i = 0; i < 0x80000; i += 2)
+				{
+					u16 w = space().read_word(i);
+					fputc((w >> 8) & 0xff, rf);
+					fputc(w & 0xff, rf);
+				}
+				fclose(rf);
+			}
+		}
+	}
