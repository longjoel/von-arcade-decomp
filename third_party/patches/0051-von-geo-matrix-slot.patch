diff --git i/src/mame/sega/model2_v.cpp w/src/mame/sega/model2_v.cpp
index 3a5bfa51..0e8a7c70 100644
--- i/src/mame/sega/model2_v.cpp
+++ w/src/mame/sega/model2_v.cpp
@@ -2007,12 +2007,27 @@ u32 *model2_state::geo_light_source(geo_state *geo, u32 opcode, u32 *input)
 u32 *model2_state::geo_matrix_write(geo_state *geo, u32 opcode, u32 *input)
 {
 	u32  i;
+	u32  raw[12];
 
 	(void)opcode;
 
 	/* read in the transformation matrix */
 	for (i = 0; i < 12; i++)
-		geo->matrix[i] = u2f(*input++);
+	{
+		raw[i] = *input++;
+		geo->matrix[i] = u2f(raw[i]);
+	}
+
+	/* Virtual-On probe: mirror the last 12 matrix words into the top of the
+	 * i960 work RAM so a host snapshot can read the camera/object transform.
+	 * Gated on VON_MATRIX_SLOT so ordinary runs are untouched. */
+	if (m_maincpu)
+	{
+		static const bool von_matrix_slot = (getenv("VON_MATRIX_SLOT") != nullptr);
+		if (von_matrix_slot)
+			for (i = 0; i < 12; i++)
+				m_maincpu->space(AS_PROGRAM).write_dword(0x5ff000 + i * 4, raw[i]);
+	}
 
 	return input;
 }
