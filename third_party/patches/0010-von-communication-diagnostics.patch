+
+void m2comm_device::diagnostic_state()
+{
+	if (!m_diagnostics)
+		return;
+
+	uint8_t role = m_shared[0x01];
+	if (role != m_diag_role)
+	{
+		osd_printf_verbose("M2COMM: diag role shared[01]=%02x (%s)\n", role,
+			role == 0x01 ? "master" : role == 0x02 ? "slave" : "unknown");
+		m_diag_role = role;
+	}
+	if (m_linkalive != m_diag_linkalive)
+	{
+		osd_printf_verbose("M2COMM: diag link-state=%s (%u)\n",
+			m_linkalive == 0 ? "searching" : m_linkalive == 1 ? "established" : "failed", m_linkalive);
+		m_diag_linkalive = m_linkalive;
+	}
+	if (memcmp(m_diag_shared, m_shared, 4) != 0)
+	{
+		osd_printf_verbose("M2COMM: diag shared[00..03]=%02x,%02x,%02x,%02x\n",
+			m_shared[0], m_shared[1], m_shared[2], m_shared[3]);
+		memcpy(m_diag_shared, m_shared, 4);
+	}
+}
+
+void m2comm_device::diagnostic_packet(const char *direction, const uint8_t *data, int size)
+{
+	if (!m_diagnostics || size < 1)
+		return;
+
+	const uint8_t id = data[0];
+	if (id == 0xff || id == 0xfe || id == 0xfc || id <= m_linkcount)
+		osd_printf_verbose("M2COMM: diag %s packet id=%02x size=%d\n", direction, id, size);
+}
 #endif
