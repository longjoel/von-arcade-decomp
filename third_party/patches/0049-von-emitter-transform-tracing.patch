+		const char *p0 = getenv("VON_FIFO_PC_MIN");
+		const char *p1 = getenv("VON_FIFO_PC_MAX");
+		const char *mx = getenv("VON_FIFO_MAX");
+		vonj_emitter_t0 = e0 ? strtod(e0, nullptr) : 0.0;
+		vonj_emitter_t1 = e1 ? strtod(e1, nullptr) : 1.0e9;
+		if (p0) vonj_fifo_pc_min = (unsigned)strtoul(p0, nullptr, 0);
+		if (p1) vonj_fifo_pc_max = (unsigned)strtoul(p1, nullptr, 0);
+		if (mx) vonj_fifo_max = strtoul(mx, nullptr, 0);
