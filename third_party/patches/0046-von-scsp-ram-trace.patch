+u16 model2_state::soundram_r(offs_t offset)
+{
+	return m_soundram[offset];
+}
+
+void model2_state::soundram_w(offs_t offset, u16 data, u16 mem_mask)
+{
+	static FILE *fp = nullptr;
+	static bool tried = false;
+	if (!tried)
+	{
+		tried = true;
+		const char *path = getenv("VON_SCSP_RAM_TRACE");
+		if (path)
+			fp = fopen(path, "w");
+	}
+	if (fp)
+		fprintf(fp, "R %.6f %x %04x %04x\n", machine().time().as_double(), offset * 2, data, mem_mask);
+	COMBINE_DATA(&m_soundram[offset]);
+}
