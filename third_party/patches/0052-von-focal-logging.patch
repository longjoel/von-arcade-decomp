diff --git i/src/mame/sega/model2_v.cpp w/src/mame/sega/model2_v.cpp
index 3a5bfa51..0e8a7c70 100644
--- i/src/mame/sega/model2_v.cpp
+++ w/src/mame/sega/model2_v.cpp
@@ -1979,6 +1979,14 @@ u32 *model2_state::geo_focal_distance(geo_state *geo, u32 opcode, u32 *input)
 	/* read the y focus value */
 	geo->focus.y = u2f(*input++);
 
+	/* Virtual-On probe: log the focal distance the game selects. The
+	 * projection multiplies view-space x/y by focus before the 1/z divide,
+	 * so this is the focal length that sets the field of view. */
+	if (machine().system().name == std::string_view("vonj"))
+		osd_printf_verbose("vonj_focus: time=%f x=%f y=%f\n",
+			machine().time().as_double(), geo->focus.x, geo->focus.y);
+
 	return input;
 }
 
